{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nimport requests, json\nqueries = [\n    'large language models authenticity writing experience',\n    'AI writing authenticity human experience',\n    'death bereavement text dataset writing',\n    'machine-generated text detection dataset human writing',\n    'computational empathy large language models authenticity'\n]\nbase = 'https://api.semanticscholar.org/graph/v1/paper/search'\nfields = 'title,year,authors,citationCount,abstract,url,openAccessPdf,venue,externalIds'\nfor q in queries:\n    params = {'query': q, 'limit': 8, 'fields': fields}\n    r = requests.get(base, params=params, timeout=60)\n    print('\\\\nQUERY:', q)\n    print('STATUS:', r.status_code)\n    data = r.json()\n    for i,p in enumerate(data.get('data', []),1):\n        title = p.get('title')\n        year = p.get('year')\n        cites = p.get('citationCount')\n        venue = p.get('venue')\n        oa = p.get('openAccessPdf',{}) or {}\n        print(f\\\"{i}. {title} | {year} | cites={cites} | venue={venue} | pdf={oa.get('url')}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
